# Local-only values for docker compose. Copy to .env (git-ignored) and change them.
# Never reuse these anywhere else.

# SQL Server 'sa' password: at least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Local-Dev-Only-Pa55!

# HS256 signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=local-dev-only-signing-key-change-me-0123456789

# Password for all seeded demo users (e.g. employee1@opsflow.local). At least 12 characters.
SEED_DEMO_PASSWORD=Demo-Password-Local-1
