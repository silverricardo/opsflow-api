{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Properties": {
      "Application": "OpsFlow.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OpsFlow": ""
  },
  "Jwt": {
    "Issuer": "opsflow",
    "Audience": "opsflow-api",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "RateLimiting": {
    "TokenPermitLimit": 5,
    "GlobalTokenLimit": 100,
    "GlobalTokensPerSecond": 50
  }
}
